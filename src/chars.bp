//// css/chars — the character walk the reader and the scoper share.
////
//// A sheet is read as its codepoints (`String.chars()`, the same unit on
//// every target, decision 320); an error names a BYTE offset of the UTF-8
//// text, which `byteOffset` counts. The skip functions answer the index just
//// past the construct they read, or `-1` when the text ends inside it.

// The character at `i`, `""` outside the text (a negative index is outside:
// `Array.at` would count it from the end).
pub fn charAt(cs: string[], i: i32) -> string {
    if (i < 0) return "";
    return cs.at(i) ?? "";
}

// The text of `cs[begin..end)`.
pub fn textOf(cs: string[], begin: i32, end: i32) -> string {
    if (end <= begin) return "";
    return cs.slice(begin, end).join("");
}

// The UTF-8 length of one codepoint.
fn utf8Length(c: string) -> i32 {
    val cp = c.charCodeAt(0);
    if (cp < 128) return 1;
    if (cp < 2048) return 2;
    if (cp < 65536) return 3;
    return 4;
}

// The byte offset of the character at `i` in the UTF-8 text.
pub fn byteOffset(cs: string[], i: i32) -> i32 {
    var bytes = 0;
    var j = 0;
    while (j < i && j < cs.length) {
        bytes = bytes + utf8Length(charAt(cs, j));
        j = j + 1;
    }
    return bytes;
}

// `css: <what> at byte <n>` — the one shape of every refusal.
pub fn problemAt(what: string, byte: i32) -> string {
    return "css: " + what + " at byte " + byte.toString();
}

// A character of an identifier: ASCII letters, digits, `-`, `_`, and every
// non-ASCII codepoint.
pub fn isNameChar(c: string) -> bool {
    if (c == "") return false;
    if (c.charCodeAt(0) >= 128) return true;
    val ascii = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789-_";
    return ascii.contains(c);
}

// CSS whitespace: space, tab, line feed, carriage return, form feed.
pub fn isSpace(c: string) -> bool {
    return c == " " || c == "\t" || c == "\n" || c == "\r" || c == "\u{C}";
}

fn isHex(c: string) -> bool {
    return "0123456789abcdefABCDEF".contains(c) && c != "";
}

// A comment opens at `i` (`/*`).
pub fn opensComment(cs: string[], i: i32) -> bool {
    return charAt(cs, i) == "/" && charAt(cs, i + 1) == "*";
}

// Past the `*/` of the comment opening at `i`; `-1` when it is not closed.
pub fn skipComment(cs: string[], i: i32) -> i32 {
    var j = i + 2;
    var end = -1;
    while (end < 0 && j < cs.length) {
        if (charAt(cs, j) == "*" && charAt(cs, j + 1) == "/")
            end = j + 2
        else
            j = j + 1;
    }
    return end;
}

// Past the escape whose `\` is at `i`: one character, or up to six hex digits
// and the one whitespace that ends them (`\31 0` is `10`'s escape and a `0`,
// not a descendant combinator). `-1` for a `\` that ends the text.
pub fn skipEscape(cs: string[], i: i32) -> i32 {
    if (i + 1 >= cs.length) return -1;
    if (isHex(charAt(cs, i + 1)) == false) return i + 2;
    var j = i + 1;
    while (j < cs.length && j < i + 7 && isHex(charAt(cs, j))) {
        j = j + 1;
    }
    if (isSpace(charAt(cs, j))) return j + 1;
    return j;
}

// Past the closing quote of the string opening at `i`; `-1` when the text
// ends first or an unescaped line break ends the line inside it (CSS's
// bad-string). An escaped line break continues the string.
pub fn skipString(cs: string[], i: i32) -> i32 {
    val quote = charAt(cs, i);
    var j = i + 1;
    var end = -2;
    while (end == -2) {
        val c = charAt(cs, j);
        if (j >= cs.length || c == "\n" || c == "\r" || c == "\u{C}")
            end = -1
        else if (c == quote)
            end = j + 1
        else if (c == "\\")
            j = if (j + 1 >= cs.length) cs.length else j + 2
        else
            j = j + 1;
    }
    return end;
}
